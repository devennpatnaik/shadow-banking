{
  "name": "@shadow-banking/controller",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 4 paper portfolio controller: snapshot → strategies → risk veto → hypothetical ledger. No live execution.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "paper": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/controller",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@shadow-banking/accounting": "workspace:*",
    "@shadow-banking/core": "workspace:*",
    "@shadow-banking/opportunity": "workspace:*",
    "@shadow-banking/risk": "workspace:*",
    "@shadow-banking/simulator": "workspace:*",
    "@shadow-banking/strategy": "workspace:*"
  }
}
